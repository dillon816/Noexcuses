# Fichier de configuration par défaut (valeurs d'exemple).
# Pour le développement local : copier ce fichier en ".env.local" et y mettre tes vraies valeurs.
# .env.local n'est jamais versionné (voir .gitignore).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_with_a_32_char_random_string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://noexcuses:noexcuses@127.0.0.1:3306/noexcuses?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_jwt_passphrase
JWT_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> api externes ###
CALORIENINJAS_API_KEY=ta_cle_calorieninjas
MISTRAL_API_KEY=ta_cle_mistral
###< api externes ###

###> connexion google (oauth) ###
# Client ID OAuth 2.0 cree dans la Google Cloud Console (public, sert cote backend et frontend)
GOOGLE_CLIENT_ID=ton_client_id.apps.googleusercontent.com
###< connexion google (oauth) ###

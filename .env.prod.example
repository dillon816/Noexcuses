# Modèle de configuration PRODUCTION.
# Copier ce fichier en ".env.prod" et remplir avec des valeurs RÉELLES et FORTES.
# Lancement : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Base de données (utiliser des mots de passe forts générés, pas ceux-ci)
MYSQL_ROOT_PASSWORD=CHANGER_root_mot_de_passe_fort
MYSQL_DATABASE=noexcuses
MYSQL_USER=noexcuses
MYSQL_PASSWORD=CHANGER_mot_de_passe_fort

# Symfony (générer un APP_SECRET aléatoire de 32+ caractères)
APP_SECRET=CHANGER_secret_aleatoire_32_caracteres
JWT_PASSPHRASE=CHANGER_passphrase_jwt
CORS_ALLOW_ORIGIN=^https://ton-domaine\.com$

# API externes (tes vraies clés)
CALORIENINJAS_API_KEY=ta_cle_calorieninjas
MISTRAL_API_KEY=ta_cle_mistral

# URL de l'API utilisée par le frontend (adapter au domaine de prod)
REACT_APP_API_URL=https://ton-domaine.com/api
